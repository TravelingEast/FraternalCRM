{
  "name": "fraternal-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Email, text messaging and contact management for Masonic bodies",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "admin": "node --disable-warning=ExperimentalWarning scripts/admin.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.6.1",
    "sanitize-html": "^2.18.2"
  }
}
