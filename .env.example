# --- Core ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000   # must be the public https URL in production (used in unsubscribe links and Twilio signature checks)
TRUST_PROXY=0                           # set to 1 when behind a reverse proxy (nginx, Caddy, Cloudflare)
ORIENT_NAME=Orient of Example
DATA_DIR=./data

# First super admin (created only when the database is empty)
SUPER_ADMIN_EMAIL=you@example.org
SUPER_ADMIN_PASSWORD=change-me-to-a-long-passphrase
SUPER_ADMIN_NAME=Statewide Administrator

# --- Text messaging: console | twilio | telnyx ---
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                            # a +E.164 number, or a Messaging Service SID starting with MG
TELNYX_API_KEY=
TELNYX_FROM=

# --- Email: console | smtp ---
EMAIL_PROVIDER=console
EMAIL_FROM=Example Lodge <news@example.org>
SMTP_URL=smtp://user:pass@smtp.example.com:587

# --- Sending pace (messages per scheduler tick) ---
TICK_MS=15000
SMS_PER_TICK=20
EMAIL_PER_TICK=50
